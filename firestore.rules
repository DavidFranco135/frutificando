rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Any authenticated user is treated as admin.
      // For extra security, replace with a specific UID check:
      // return request.auth.uid == "YOUR_ADMIN_UID";
      return isAuthenticated();
    }

    // ─── inscricoes ──────────────────────────────────────────────────────────
    // Anyone can submit a new registration.
    // Only admins can read, update, or delete.
    match /inscricoes/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── conteudo_site ───────────────────────────────────────────────────────
    // Anyone can read site content (so the public site can fetch it).
    // Only admins can write.
    match /conteudo_site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── galeria ─────────────────────────────────────────────────────────────
    // Anyone can read the gallery (public site).
    // Only admins can write.
    match /galeria/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── config ──────────────────────────────────────────────────────────────
    // Anyone can read config (needed for vacancy count on public form).
    // create/update is allowed for authenticated users (inscription process
    // updates vagas_ocupadas) and full write for admins.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
